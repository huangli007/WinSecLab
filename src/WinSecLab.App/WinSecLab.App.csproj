<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WinSecLab.App</RootNamespace>
    <AssemblyName>WinSecLab</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>WinSecLab</Product>
    <Company>WinSecLab</Company>
    <Description>Windows PC Application Security Testing Workbench</Description>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 项目的隐式 using 集合不含 System.IO，显式补上，避免每页都写一遍 -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinSecLab.Core\WinSecLab.Core.csproj" />
  </ItemGroup>

</Project>
