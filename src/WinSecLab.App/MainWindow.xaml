<Window x:Class="WinSecLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
        Title="WinSecLab — Windows 应用安全测试平台"
        Icon="Assets/wsl.ico"
        Height="880" Width="1480"
        MinHeight="640" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg}"
        FontFamily="{StaticResource F.Ui}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ 左侧导航 ═══════════ -->
        <Border Grid.Column="0" Background="{StaticResource B.NavBg}" BorderBrush="{StaticResource B.Border}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource B.Accent}">
                            <TextBlock Text="W" Foreground="White" FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinSecLab" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource B.Text}" />
                            <TextBlock Text="应用安全测试平台" FontSize="10.5"
                                       Foreground="{StaticResource B.TextFaint}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 导航项 -->
                <ListBox x:Name="NavList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="NavList_OnSelectionChanged">
                    <ListBoxItem Content="项目" Tag="Home" />
                    <ListBoxItem Content="测试执行" Tag="Run" />
                    <ListBoxItem Content="概览" Tag="Overview" />
                    <ListBoxItem Content="安全发现" Tag="Findings" />
                    <ListBoxItem Content="证据库" Tag="Evidence" />
                    <ListBoxItem Content="动态行为" Tag="Dynamic" />
                    <ListBoxItem Content="安全图谱" Tag="Graph" />
                    <ListBoxItem Content="轮次对比" Tag="Comparison" />
                    <ListBoxItem Content="报告" Tag="Reports" />
                    <ListBoxItem Content="插件与工具" Tag="Plugins" />
                    <ListBoxItem Content="设置" Tag="Settings" />
                </ListBox>

                <!-- 底部信息 -->
                <StackPanel Grid.Row="2" Margin="20,12,20,18">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                    <TextBlock Text="工作区" Style="{StaticResource T.Caption}" />
                    <TextBlock x:Name="WorkspaceText" Style="{StaticResource T.Caption}"
                               Foreground="{StaticResource B.TextDim}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ShowDuration="30000" />
                    <TextBlock Text="仅限对已获授权的软件进行安全测试" Style="{StaticResource T.Caption}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 右侧主体 ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部栏 -->
            <Border Grid.Row="0" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,0,0,1" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource T.H2}" Text="{Binding ProjectTitle}" />
                        <TextBlock Style="{StaticResource T.Caption}" Text="{Binding ProjectSubtitle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.CriticalSoft}" Margin="0,0,5,0">
                                <TextBlock Text="{Binding CriticalCount, StringFormat=严重 {0}}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Critical}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.HighSoft}" Margin="0,0,5,0">
                                <TextBlock Text="{Binding HighCount, StringFormat=高 {0}}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.High}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.MediumSoft}" Margin="0,0,5,0">
                                <TextBlock Text="{Binding MediumCount, StringFormat=中 {0}}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Medium}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.LowSoft}" Margin="0,0,5,0">
                                <TextBlock Text="{Binding LowCount, StringFormat=低 {0}}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Low}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.InfoSoft}">
                                <TextBlock Text="{Binding InfoCount, StringFormat=提示 {0}}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource B.Info}" />
                            </Border>
                        </StackPanel>

                        <Button Content="报告目录" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                                Click="OpenReportFolder_OnClick"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}" />
                        <Button Content="停止" Style="{StaticResource Btn.Danger}"
                                Click="Cancel_OnClick"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ContentControl x:Name="ContentHost" Grid.Row="1" />

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}"
                    BorderThickness="0,1,0,0" Padding="22,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource T.Caption}"
                               Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}" Style="{StaticResource T.Caption}"
                                   HorizontalAlignment="Right" Margin="0,0,0,4" />
                        <ProgressBar Style="{StaticResource SlimProgress}" Minimum="0" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
