<UserControl x:Class="WinSecLab.App.Views.EvidenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
             Background="{StaticResource B.Bg}">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="460" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,16,18,10">
                    <TextBlock Text="证据库" Style="{StaticResource T.H1}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                               Text="证据是分析的原始事实，每个结论都可以回溯到这里。" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="18,0,18,10">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Tb}" Width="230"
                             HorizontalAlignment="Left" TextChanged="Search_OnChanged" />
                    <ComboBox x:Name="KindBox" Width="160" HorizontalAlignment="Left" Margin="240,0,0,0"
                              SelectionChanged="Kind_OnChanged" />
                    <TextBlock x:Name="CountText" Style="{StaticResource T.Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <DataGrid x:Name="EvidenceGrid" Grid.Row="2" Style="{StaticResource Grid}" BorderThickness="0"
                          SelectionChanged="EvidenceGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="120" />
                        <DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" Width="92" />
                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="130" />
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="76" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource T.Dim}" Margin="24"
                           Text="从左侧选择一条证据查看结构化内容。" VerticalAlignment="Top" />

                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="DetailId" Style="{StaticResource T.Caption}" />
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource T.H1}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailTarget" Style="{StaticResource T.Mono}" Margin="0,6,0,0"
                                   Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap" />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="摘要" Style="{StaticResource T.Label}" />
                        <TextBlock x:Name="DetailSummary" Style="{StaticResource T.Body}" />

                        <StackPanel x:Name="MetaBlock" Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.InfoSoft}" Margin="0,0,6,0">
                                <TextBlock x:Name="DetailKind" FontSize="10.5" Foreground="{StaticResource B.Info}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.InfoSoft}" Margin="0,0,6,0">
                                <TextBlock x:Name="DetailSource" FontSize="10.5" Foreground="{StaticResource B.Info}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.InfoSoft}">
                                <TextBlock x:Name="DetailTime" FontSize="10.5" Foreground="{StaticResource B.Info}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="标签" Style="{StaticResource T.Label}" Margin="0,14,0,4"
                                   x:Name="TagsLabel" />
                        <ItemsControl x:Name="TagList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource B.AccentSoft}"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                   Foreground="{StaticResource B.Accent}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="结构化内容（JSON）" Style="{StaticResource T.Label}" Margin="0,12,0,4" />
                        <TextBox x:Name="JsonBox" Style="{StaticResource Tb.Mono}" Height="360" />

                        <Button Content="复制 JSON" Style="{StaticResource Btn.Secondary}" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Click="CopyJson_OnClick" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
