<UserControl x:Class="WinSecLab.App.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
             Background="{StaticResource B.Bg}">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVis" />
        <infra:StringToVisibilityConverter x:Key="StrVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：任务选择 -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,16,18,10">
                    <TextBlock Text="测试任务" Style="{StaticResource T.H1}" />
                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                               Text="勾选要执行的任务。未安装的外部工具会由其对应内置引擎兜底，不会导致任务失败。" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,8,0">
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource B.SurfaceAlt}" CornerRadius="6" Padding="11,9"
                                        Margin="0,0,0,6" BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" FontWeight="SemiBold">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding EnglishName, StringFormat=({0})}"
                                                           FontSize="10.5" FontFamily="{StaticResource F.Mono}"
                                                           Foreground="{StaticResource B.TextFaint}"
                                                           VerticalAlignment="Center" Margin="5,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}"
                                                   Margin="22,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="22,5,0,0">
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.AccentSoft}">
                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="10"
                                                           Foreground="{StaticResource B.Accent}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.MediumSoft}"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding Badge, Converter={StaticResource StrVis}}">
                                                <TextBlock Text="{Binding Badge}" FontSize="10"
                                                           Foreground="{StaticResource B.Medium}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 操作区 -->
                <StackPanel Grid.Row="2" Margin="18,12,18,16">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Profile" Style="{StaticResource T.Label}" />
                        <ComboBox x:Name="ProfileBox" HorizontalAlignment="Right" Width="196"
                                  SelectionChanged="ProfileBox_OnSelectionChanged">
                            <ComboBoxItem Content="Basic" Tag="Basic" />
                            <ComboBoxItem Content="Desktop Application" Tag="DesktopApplication" />
                            <ComboBoxItem Content=".NET Application" Tag="DotNetApplication" />
                            <ComboBoxItem Content="Full Security Assessment" Tag="FullSecurityAssessment" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="动态会话时长（秒）" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <TextBox x:Name="RunSecondsBox" Style="{StaticResource Tb}" Width="72"
                                 HorizontalAlignment="Right" Text="60" />
                    </Grid>

                    <CheckBox x:Name="ReportCheck" Content="分析结束后自动生成报告" IsChecked="True" Margin="0,0,0,4" />
                    <CheckBox x:Name="ExternalCheck" Content="优先调用已安装的外部工具" IsChecked="True" Margin="0,0,0,12" />

                    <Button x:Name="StartButton" Content="开始分析" Style="{StaticResource Btn.Primary}"
                            HorizontalAlignment="Stretch" Padding="0,10" Click="Start_OnClick" />
                    <TextBlock x:Name="RunHintText" Style="{StaticResource T.Caption}" Margin="0,8,0,0"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右：日志 + 实时事件 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="0.85*" />
            </Grid.RowDefinitions>

            <!-- 执行日志 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="执行日志" Style="{StaticResource T.H2}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.AccentSoft}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                           Foreground="{StaticResource B.Accent}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="清空" Style="{StaticResource Btn.Ghost}" Click="ClearLog_OnClick" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0" Background="{StaticResource B.SurfaceAlt}"
                             ItemsSource="{Binding LogLines}" VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="14,0,14,14">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" Margin="2,1" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 实时事件流 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="实时事件流" Style="{StaticResource T.H2}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource T.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="（分析期间实时刷新，最多保留 2000 条）" />
                        </StackPanel>
                        <TextBlock x:Name="LiveCountText" Style="{StaticResource T.Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <DataGrid x:Name="LiveGrid" Grid.Row="1" Style="{StaticResource Grid}" BorderThickness="0"
                              ItemsSource="{Binding LiveEvents}" Margin="14,0,14,14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="92" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="110" />
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="140" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="68" />
                            <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="150" />
                            <DataGridTextColumn Header="对象" Binding="{Binding Target}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
