<UserControl x:Class="WinSecLab.App.Views.DynamicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
             Background="{StaticResource B.Bg}">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="动态行为" Style="{StaticResource T.H1}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource Tab}">
            <!-- 事件时间线 -->
            <TabItem Header="事件时间线">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,14,16,10">
                            <TextBox x:Name="EventSearchBox" Style="{StaticResource Tb}" Width="240"
                                     HorizontalAlignment="Left" TextChanged="EventSearch_OnChanged" />
                            <CheckBox x:Name="SuspiciousOnlyCheck" Content="只看可疑事件" HorizontalAlignment="Left"
                                      Margin="256,0,0,0" VerticalAlignment="Center" Checked="EventFilter_OnChanged"
                                      Unchecked="EventFilter_OnChanged" />
                            <TextBlock x:Name="EventCountText" Style="{StaticResource T.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid x:Name="EventGrid" Grid.Row="1" Style="{StaticResource Grid}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="96" />
                                <DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="118" />
                                <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="160" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="150" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="96" />
                                <DataGridTextColumn Header="对象" Binding="{Binding Target}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 进程树 -->
            <TabItem Header="进程树">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                    <DataGrid x:Name="TreeGrid" Style="{StaticResource Grid}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="层级" Binding="{Binding Depth}" Width="60" />
                            <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90" />
                            <DataGridTextColumn Header="父 PID" Binding="{Binding ParentPid}" Width="90" />
                            <DataGridTextColumn Header="启动时间" Binding="{Binding StartTime, StringFormat=HH:mm:ss}" Width="110" />
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- 网络连接 -->
            <TabItem Header="网络连接">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,14,16,10">
                            <TextBox x:Name="ConnSearchBox" Style="{StaticResource Tb}" Width="240"
                                     HorizontalAlignment="Left" TextChanged="ConnSearch_OnChanged" />
                            <TextBlock x:Name="ConnCountText" Style="{StaticResource T.Caption}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid x:Name="ConnGrid" Grid.Row="1" Style="{StaticResource Grid}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70" />
                                <DataGridTextColumn Header="本地" Binding="{Binding LocalEndpoint}" Width="170" />
                                <DataGridTextColumn Header="远端" Binding="{Binding RemoteEndpoint}" Width="170" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="110" />
                                <DataGridTextColumn Header="域名" Binding="{Binding Domain}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- DNS -->
            <TabItem Header="DNS 观测">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                    <DataGrid x:Name="DnsGrid" Style="{StaticResource Grid}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="主机名" Binding="{Binding HostName}" Width="*" />
                            <DataGridTextColumn Header="解析结果" Binding="{Binding AddressText}" Width="260" />
                            <DataGridTextColumn Header="记录类型" Binding="{Binding RecordType}" Width="90" />
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="140" />
                            <DataGridTextColumn Header="归因质量" Binding="{Binding Attribution}" Width="100" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- HTTP -->
            <TabItem Header="HTTP 事务">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock x:Name="HttpHint" Style="{StaticResource T.Dim}" Margin="20"
                                   TextWrapping="Wrap" VerticalAlignment="Top"
                                   Text="没有捕获到 HTTP 事务。需要把被测程序的系统代理指向本机代理端口（默认 127.0.0.1:8877），并且目标使用明文 HTTP。" />
                        <DataGrid x:Name="HttpGrid" Style="{StaticResource Grid}" BorderThickness="0"
                                  Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="86" />
                                <DataGridTextColumn Header="方法" Binding="{Binding Method}" Width="72" />
                                <DataGridTextColumn Header="主机" Binding="{Binding Host}" Width="200" />
                                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusCode}" Width="70" />
                                <DataGridTextColumn Header="响应长度" Binding="{Binding ResponseBodyLength}" Width="90" />
                                <DataGridTextColumn Header="关注点" Binding="{Binding ExchangeNote}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- YARA -->
            <TabItem Header="YARA 命中">
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,8,0,0">
                    <DataGrid x:Name="YaraGrid" Style="{StaticResource Grid}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="规则" Binding="{Binding RuleName}" Width="260" />
                            <DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="80" />
                            <DataGridTextColumn Header="文件" Binding="{Binding FilePath}" Width="*" />
                            <DataGridTextColumn Header="引擎" Binding="{Binding Source}" Width="90" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
