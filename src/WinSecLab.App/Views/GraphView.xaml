<UserControl x:Class="WinSecLab.App.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
             Background="{StaticResource B.Bg}">
    <UserControl.Resources>
        <infra:SeverityBrushConverter x:Key="SevBrush" />
        <infra:SeverityTextConverter x:Key="SevText" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,16,18,8">
                    <StackPanel>
                        <TextBlock Text="安全图谱" Style="{StaticResource T.H1}" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                                   Text="按同心圆分层：内环是目标与模块，外环依次是进程、网络、文件、注册表、发现。节点越红风险越高。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <CheckBox x:Name="ShowLabelsCheck" Content="显示标签" IsChecked="True"
                                  Checked="ToggleLabels_OnChanged" Unchecked="ToggleLabels_OnChanged" />
                        <Button Content="重置视图" Style="{StaticResource Btn.Secondary}" Click="Reset_OnClick" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="14,0,14,10" CornerRadius="8"
                        Background="{StaticResource B.SurfaceAlt}" BorderBrush="{StaticResource B.Border}"
                        BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource T.Dim}" Margin="24"
                                   VerticalAlignment="Top"
                                   Text="还没有图谱数据。执行一次分析后这里会展开实体关系图。" />
                        <Canvas x:Name="GraphCanvas" Background="Transparent"
                                MouseWheel="GraphCanvas_OnMouseWheel"
                                MouseLeftButtonDown="GraphCanvas_OnMouseDown"
                                MouseLeftButtonUp="GraphCanvas_OnMouseUp"
                                MouseMove="GraphCanvas_OnMouseMove" />
                        <TextBlock x:Name="NodeTip" Style="{StaticResource T.Caption}"
                                   Background="{StaticResource B.Surface}" Padding="8,4"
                                   Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,0,18,16">
                    <ItemsControl x:Name="LegendList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Caption}"
                                               Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ZoomText" Style="{StaticResource T.Caption}" VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右：节点清单 + 选中详情 -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,16,16,8">
                    <TextBlock Text="节点清单" Style="{StaticResource T.H2}" />
                    <TextBlock x:Name="NodeCountText" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="16,0,16,8">
                    <CheckBox x:Name="SuspiciousOnlyCheck" Content="只看可疑节点"
                              Checked="NodeFilter_OnChanged" Unchecked="NodeFilter_OnChanged" />
                </StackPanel>

                <DataGrid x:Name="NodeGrid" Grid.Row="2" Style="{StaticResource Grid}" BorderThickness="0"
                          SelectionChanged="NodeGrid_OnSelectionChanged" MinHeight="160">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="类别" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource T.Caption}"
                                               Foreground="{StaticResource B.Text}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="权重" Binding="{Binding Weight}" Width="56" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 选中节点详情 -->
                <!-- 选中节点详情（无选中时整块隐藏，由代码控制） -->
                <Border x:Name="SelDetailPanel" Grid.Row="3" Background="{StaticResource B.SurfaceAlt}"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="16,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="选中节点" Style="{StaticResource T.Label}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.AccentSoft}">
                                <TextBlock x:Name="SelKind" FontSize="10.5" Foreground="{StaticResource B.Accent}" />
                            </Border>
                            <Border x:Name="SelSuspectBadge" Style="{StaticResource Badge}" Background="#FCEBEB"
                                    Margin="6,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="SelSeverity" FontSize="10.5" Foreground="#9C0006" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SelLabel" Style="{StaticResource T.H3}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelPath" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextDim}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelDetail" Style="{StaticResource T.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 关联信息 -->
                <ScrollViewer Grid.Row="4" MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="16,4,16,14">
                    <StackPanel x:Name="SelRelationsPanel">
                        <TextBlock x:Name="SelEvidenceHeader" Style="{StaticResource T.Label}" Margin="0,10,0,4" />
                        <ItemsControl x:Name="SelEvidenceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                               Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="SelFindingHeader" Style="{StaticResource T.Label}" Margin="0,10,0,4" />
                        <ItemsControl x:Name="SelFindingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                               Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="SelEdgeHeader" Style="{StaticResource T.Label}" Margin="0,10,0,4" />
                        <ItemsControl x:Name="SelEdgeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                                               Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
