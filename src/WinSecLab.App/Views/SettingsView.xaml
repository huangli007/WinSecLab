<UserControl x:Class="WinSecLab.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22" MaxWidth="820" HorizontalAlignment="Left">

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="工作区" Style="{StaticResource T.H1}" />
                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                               Text="所有项目、规则与插件都放在工作区下。可用环境变量 WINSECLAB_WORKSPACE 覆盖默认位置。" />

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Text="当前工作区路径" Style="{StaticResource T.Label}" />
                    <TextBlock x:Name="WorkspaceText" Style="{StaticResource T.Mono}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="打开工作区" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                                Click="OpenWorkspace_OnClick" />
                        <Button Content="打开规则目录" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                                Click="OpenRules_OnClick" />
                        <Button Content="打开插件目录" Style="{StaticResource Btn.Secondary}"
                                Click="OpenPlugins_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="分析默认值" Style="{StaticResource T.H2}" />
                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                               Text="这些值会作为「测试执行」页的默认选项。" />

                    <Border Style="{StaticResource Divider}" />

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="默认 Profile" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ProfileBox" Width="240" HorizontalAlignment="Right">
                            <ComboBoxItem Content="Basic" Tag="Basic" />
                            <ComboBoxItem Content="Desktop Application" Tag="DesktopApplication" />
                            <ComboBoxItem Content=".NET Application" Tag="DotNetApplication" />
                            <ComboBoxItem Content="Full Security Assessment" Tag="FullSecurityAssessment" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="动态会话时长（秒）" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <TextBox x:Name="RunSecondsBox" Style="{StaticResource Tb}" Width="90"
                                 HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="分析员署名（写进报告）" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <TextBox x:Name="AnalystBox" Style="{StaticResource Tb}" Width="240"
                                 HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="组织名称" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <TextBox x:Name="OrgBox" Style="{StaticResource Tb}" Width="240"
                                 HorizontalAlignment="Right" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <CheckBox x:Name="PreferExternalCheck" Content="优先调用已安装的外部工具（替代型工具会接管对应任务）" />
                    <CheckBox x:Name="CopyTargetCheck" Content="导入时把目标文件复制进项目目录（用于取证与哈希比对）" />
                    <CheckBox x:Name="AutoReportCheck" Content="分析结束后自动生成报告" />

                    <Button Content="保存设置" Style="{StaticResource Btn.Primary}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Padding="20,9" Click="Save_OnClick" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="YARA 规则" Style="{StaticResource T.H2}" />
                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                               Text="把自定义 .yar 文件放进工作区的 Rules 目录即可自动加载。平台会解析常用的那一档语法；遇到不支持的写法（正则、module、for 循环）会明确警告并降级，绝不静默曲解规则语义。" />
                    <Button Content="打开规则目录" Style="{StaticResource Btn.Secondary}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Click="OpenRules_OnClick" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="能力与限制" Style="{StaticResource T.H2}" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="平台 会做的事" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,10" TextWrapping="Wrap"
                               Text="• 解析 PE 结构、导入导出、资源、调试路径，并计算三哈希与 imphash&#10;• 校验数字签名与时间戳，做同目录二进制签名普查&#10;• 按 PID 观测 TCP/UDP 连接与 DNS，监控进程 / 文件 / 注册表变更&#10;• 用规则引擎跨证据归纳，生成可回溯到原始证据的发现项与报告" />
                    <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="平台 不会 做的事" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="• 不自行实现反编译器 / 调试器 —— Ghidra、x64dbg 通过工作流适配接入&#10;• 不做 HTTPS 中间人解密（明文 HTTP 走本地正向代理）&#10;• 不修改被测程序的任何文件或注册表项（监控全部只读）&#10;• 不把结论包装成「确定恶意」，只给事实与可验证的推理" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap"
                               Text="本工具仅限对已获授权的软件进行安全测试。未获授权的测试可能违反法律与服务条款。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
