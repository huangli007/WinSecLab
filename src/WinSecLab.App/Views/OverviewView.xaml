<UserControl x:Class="WinSecLab.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
             Background="{StaticResource B.Bg}">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVis" />
        <infra:SeverityBrushConverter x:Key="SevBrush" />
        <infra:SeverityTextConverter x:Key="SevText" />
        <infra:StringToVisibilityConverter x:Key="StrVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">

            <!-- 空状态 -->
            <Border Style="{StaticResource Card}" Padding="40"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="还没有分析结果" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource T.Dim}" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Text="到「测试执行」页选好任务并开始分析，或选择一个已有项目载入历史结果。" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">

                <!-- 结论卡片 -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="总体结论" Style="{StaticResource T.Label}" />
                            <TextBlock Text="{Binding OverallVerdict}" Style="{StaticResource T.H1}" />
                            <TextBlock Text="{Binding FindingStats}" Style="{StaticResource T.Dim}" Margin="0,5,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="10,0" MinWidth="66">
                                <TextBlock Text="{Binding CriticalCount}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource B.Critical}" HorizontalAlignment="Center" />
                                <TextBlock Text="严重" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="10,0" MinWidth="66">
                                <TextBlock Text="{Binding HighCount}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource B.High}" HorizontalAlignment="Center" />
                                <TextBlock Text="高" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="10,0" MinWidth="66">
                                <TextBlock Text="{Binding MediumCount}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource B.Medium}" HorizontalAlignment="Center" />
                                <TextBlock Text="中" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="10,0" MinWidth="66">
                                <TextBlock Text="{Binding LowCount}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource B.Low}" HorizontalAlignment="Center" />
                                <TextBlock Text="低" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="10,0" MinWidth="66">
                                <TextBlock Text="{Binding InfoCount}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource B.Info}" HorizontalAlignment="Center" />
                                <TextBlock Text="提示" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 应用信息 + 类型识别 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="应用信息" Style="{StaticResource T.H2}" />
                            <Border Style="{StaticResource Divider}" />

                            <UniformGrid Columns="2" Rows="4">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="文件名" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding CurrentProject.Target.FileName}" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="大小" Style="{StaticResource T.Label}" />
                                    <TextBlock x:Name="SizeText" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="架构" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding CurrentProject.Target.Architecture}" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="子系统" Style="{StaticResource T.Label}" />
                                    <TextBlock x:Name="SubsystemText" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="文件版本" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding CurrentProject.Target.FileVersion}" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="产品名称" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding CurrentProject.Target.ProductName}" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="厂商" Style="{StaticResource T.Label}" />
                                    <TextBlock Text="{Binding CurrentProject.Target.CompanyName}" Style="{StaticResource T.Body}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="编译器" Style="{StaticResource T.Label}" />
                                    <TextBlock x:Name="CompilerText" Style="{StaticResource T.Body}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="SHA-256" Style="{StaticResource T.Label}" Margin="0,6,0,3" />
                            <TextBlock Text="{Binding CurrentProject.Target.Sha256}" Style="{StaticResource T.Mono}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="运行类型识别" Style="{StaticResource T.H2}" />
                            <Border Style="{StaticResource Divider}" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RuntimeText" Text="未识别" Style="{StaticResource T.H1}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge}" Background="{StaticResource B.AccentSoft}" Margin="10,0,0,0">
                                    <TextBlock x:Name="ConfidenceText" FontSize="11"
                                               Foreground="{StaticResource B.Accent}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="建议使用的分析器" Style="{StaticResource T.Label}" Margin="0,14,0,4" />
                            <ItemsControl x:Name="AnalyzerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource T.Body}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="建议接入的外部工具" Style="{StaticResource T.Label}" Margin="0,14,0,4" />
                            <ItemsControl x:Name="ToolList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource T.Body}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="命中的识别信号" Style="{StaticResource T.Label}" Margin="0,14,0,4" />
                            <ItemsControl x:Name="SignalList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource T.Body}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}"
                                                    Background="{StaticResource B.InfoSoft}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Weight, StringFormat=+{0}}" FontSize="10"
                                                           Foreground="{StaticResource B.Info}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 关键计数 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="采集规模" Style="{StaticResource T.H2}" />
                        <Border Style="{StaticResource Divider}" />
                        <UniformGrid Columns="6">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding EvidenceCount}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="证据条目" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding EventCount}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="监控事件" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding ConnectionCount}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="网络连接" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="DnsCountText" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="DNS 记录" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock x:Name="HttpCountText" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="HTTP 事务" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding YaraCount}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="YARA 命中" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 最高风险项 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="最需要优先处理的发现" Style="{StaticResource T.H2}" />
                        <Border Style="{StaticResource Divider}" />
                        <ItemsControl x:Name="TopFindingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubCard}" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource Badge}" VerticalAlignment="Top"
                                                    Background="{Binding Severity, Converter={StaticResource SevBrush},
                                                                         ConverterParameter=bg}">
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource SevText}}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Target}" Style="{StaticResource T.Caption}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding RuleId}" Style="{StaticResource T.Caption}"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoFindingText" Style="{StaticResource T.Dim}" Margin="0,6,0,0"
                                   Text="没有发现需要优先处理的问题。" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 测试环境 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="测试环境" Style="{StaticResource T.H2}" />
                        <Border Style="{StaticResource Divider}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="主机 / 用户" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="MachineText" Style="{StaticResource T.Body}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="操作系统" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="OsText" Style="{StaticResource T.Body}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="运行时" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="RuntimeVersionText" Style="{StaticResource T.Body}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="权限" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="ElevatedText" Style="{StaticResource T.Body}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="逻辑处理器" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="CpuText" Style="{StaticResource T.Body}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="内存（可用）" Style="{StaticResource T.Label}" />
                                <TextBlock x:Name="MemoryText" Style="{StaticResource T.Body}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
