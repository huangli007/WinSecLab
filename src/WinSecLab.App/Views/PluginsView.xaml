<UserControl x:Class="WinSecLab.App.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
             Background="{StaticResource B.Bg}">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolVis" />
        <infra:StringToVisibilityConverter x:Key="StrVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="插件与外部工具" Style="{StaticResource T.H1}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                               Text="内置引擎零外部依赖，开箱即用；检测到外部工具时会自动接入，用于交叉验证或补齐内置引擎拿不到的数据。" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="重新探测" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                            Click="Reprobe_OnClick" />
                    <Button Content="打开插件目录" Style="{StaticResource Btn.Secondary}"
                            Click="OpenPluginDir_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Top" Margin="0,6,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#C7CCDA" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Available}" Value="True">
                                                    <Setter Property="Fill" Value="#16A34A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource B.InfoSoft}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Version}" FontSize="10"
                                                       Foreground="{StaticResource B.Info}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource B.AccentSoft}"
                                                Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Id}" FontSize="10" FontFamily="{StaticResource F.Mono}"
                                                       Foreground="{StaticResource B.Accent}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource T.Dim}"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Caption}"
                                               Margin="0,4,0,0" />

                                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                                               Foreground="{StaticResource B.Warn}"
                                               Text="{Binding InstallHint, StringFormat=安装方式：{0}}"
                                               Visibility="{Binding Available, Converter={StaticResource BoolVis},
                                                                    ConverterParameter=invert}" />

                                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0"
                                               Text="{Binding ExecutablePath, StringFormat=路径：{0}}"
                                               Visibility="{Binding ExecutablePath, Converter={StaticResource StrVis}}" />

                                    <ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Badge}" Background="#F2F4F8"
                                                        Margin="0,0,5,4">
                                                    <TextBlock Text="{Binding}" FontSize="10"
                                                               Foreground="{StaticResource B.TextDim}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <CheckBox Content="启用" IsChecked="{Binding Enabled, Mode=OneWay}"
                                              Click="TogglePlugin_OnClick" Tag="{Binding Id}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
