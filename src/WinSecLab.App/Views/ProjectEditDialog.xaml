<Window x:Class="WinSecLab.App.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑项目" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource B.Bg}"
        ShowInTaskbar="False">
    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="编辑项目信息" Style="{StaticResource T.H1}" />
        <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                   Text="只改项目记录，不会重命名项目目录（目录名是创建时的快照）。" />

        <TextBlock Text="项目名称" Style="{StaticResource T.Label}" Margin="0,16,0,4" />
        <TextBox x:Name="NameBox" Style="{StaticResource Tb}" />

        <TextBlock Text="描述" Style="{StaticResource T.Label}" Margin="0,14,0,4" />
        <TextBox x:Name="DescriptionBox" Style="{StaticResource Tb}" Height="62"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

        <TextBlock Text="测试执行人" Style="{StaticResource T.Label}" Margin="0,14,0,4" />
        <TextBox x:Name="AuthorBox" Style="{StaticResource Tb}" />

        <TextBlock Text="授权信息" Style="{StaticResource T.Label}" Margin="0,14,0,4" />
        <TextBox x:Name="AuthorizationBox" Style="{StaticResource Tb}" />
        <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                   Text="例如：经 XX 部门授权，仅限内部测试环境使用。" />

        <TextBlock x:Name="ErrorText" Foreground="#9C0006" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_OnClick" />
            <Button Content="保存" Style="{StaticResource Btn.Primary}" IsDefault="True"
                    Click="Save_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
