<UserControl x:Class="WinSecLab.App.Views.FindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:WinSecLab.App.Infrastructure"
             Background="{StaticResource B.Bg}">
    <UserControl.Resources>
        <infra:SeverityBrushConverter x:Key="SevBrush" />
        <infra:SeverityTextConverter x:Key="SevText" />
        <infra:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="480" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- 左：发现列表 -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,16,18,10">
                    <TextBlock Text="安全发现" Style="{StaticResource T.H1}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="18,0,18,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="AllRadio" Content="全部" IsChecked="True" GroupName="Sev"
                                     Checked="Filter_OnChanged" />
                        <RadioButton x:Name="CriticalRadio" Content="严重" GroupName="Sev" Checked="Filter_OnChanged" />
                        <RadioButton x:Name="HighRadio" Content="高" GroupName="Sev" Checked="Filter_OnChanged" />
                        <RadioButton x:Name="MediumRadio" Content="中" GroupName="Sev" Checked="Filter_OnChanged" />
                        <RadioButton x:Name="LowRadio" Content="低" GroupName="Sev" Checked="Filter_OnChanged" />
                        <RadioButton x:Name="InfoRadio" Content="提示" GroupName="Sev" Checked="Filter_OnChanged" />
                    </StackPanel>
                    <Button Content="导出清单 CSV" Style="{StaticResource Btn.Secondary}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="ExportCsv_OnClick"
                            ToolTip="导出为 CSV，可直接用 Excel 打开做跟踪表" />
                </Grid>

                <DataGrid x:Name="FindingGrid" Grid.Row="2" Style="{StaticResource Grid}" BorderThickness="0"
                          SelectionChanged="FindingGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="级别" Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding Severity, Converter={StaticResource SevBrush},
                                                                 ConverterParameter=bg}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Severity, Converter={StaticResource SevText}}"
                                                   FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Severity, Converter={StaticResource SevBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="72" />
                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="规则" Binding="{Binding RuleId}" Width="76" />
                        <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceText}" Width="72" />
                        <DataGridTextColumn Header="处理状态" Binding="{Binding StatusText}" Width="86" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 右：详情 -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <Grid>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource T.Dim}" Margin="24"
                           Text="从左侧选择一条发现查看详情。" VerticalAlignment="Top" />

                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="20">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Badge}"
                                    Background="{Binding SelectedItem.Severity, ElementName=FindingGrid,
                                                         Converter={StaticResource SevBrush}, ConverterParameter=bg}">
                                <TextBlock x:Name="DetailSeverity" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding SelectedItem.Severity, ElementName=FindingGrid,
                                                                Converter={StaticResource SevBrush}}" />
                            </Border>
                            <TextBlock x:Name="DetailRuleId" Style="{StaticResource T.Caption}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DetailConfidence" Style="{StaticResource T.Caption}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="DetailTitle" Style="{StaticResource T.H1}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailTarget" Style="{StaticResource T.Mono}" Margin="0,6,0,0"
                                   Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap" />

                        <!-- 人工复核闭环（§9 人工深入分析）：处理状态 + 复核意见 -->
                        <Border Style="{StaticResource SubCard}" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="人工复核" Style="{StaticResource T.Label}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="处理状态" Style="{StaticResource T.Caption}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="ReviewStatusBox" Width="130"
                                              SelectionChanged="ReviewStatus_OnChanged" />
                                    <Border x:Name="ReviewSavedBadge" Style="{StaticResource Badge}"
                                            Background="{StaticResource B.SuccessSoft}" Margin="10,0,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock Text="已保存" FontSize="10.5"
                                                   Foreground="{StaticResource B.Success}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="复核意见" Style="{StaticResource T.Caption}" Margin="0,10,0,3" />
                                <TextBox x:Name="ReviewNoteBox" MinHeight="54" MaxHeight="120"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource Tb}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="保存复核" Style="{StaticResource Btn.Primary}"
                                            Click="SaveReview_OnClick" />
                                    <TextBlock x:Name="ReviewHint" Style="{StaticResource T.Caption}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="问题描述" Style="{StaticResource T.Label}" />
                        <TextBlock x:Name="DetailDescription" Style="{StaticResource T.Body}" />

                        <StackPanel x:Name="ImpactBlock">
                            <TextBlock Text="影响" Style="{StaticResource T.Label}" Margin="0,14,0,3" />
                            <TextBlock x:Name="DetailImpact" Style="{StaticResource T.Body}" />
                        </StackPanel>

                        <StackPanel x:Name="ReproBlock">
                            <TextBlock Text="复现步骤" Style="{StaticResource T.Label}" Margin="0,14,0,3" />
                            <TextBlock x:Name="DetailReproduction" Style="{StaticResource T.Body}" />
                        </StackPanel>

                        <StackPanel x:Name="RecommendBlock">
                            <TextBlock Text="整改建议" Style="{StaticResource T.Label}" Margin="0,14,0,3" />
                            <TextBlock x:Name="DetailRecommendation" Style="{StaticResource T.Body}" />
                        </StackPanel>

                        <StackPanel x:Name="StandardBlock" Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.InfoSoft}" Margin="0,0,6,0">
                                <TextBlock x:Name="DetailCwe" FontSize="10.5" Foreground="{StaticResource B.Info}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource B.InfoSoft}">
                                <TextBlock x:Name="DetailOwasp" FontSize="10.5" Foreground="{StaticResource B.Info}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="关联证据" Style="{StaticResource T.Label}" Margin="0,16,0,4" />
                        <ItemsControl x:Name="EvidenceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SubCard}" Padding="10,7" Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Caption}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="关联实体" Style="{StaticResource T.Label}" Margin="0,14,0,4" />
                        <ItemsControl x:Name="EntityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
